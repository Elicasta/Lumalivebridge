{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma Live",
  "version": "0.5.2",
  "identifier": "com.eccreative.lumalive",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Luma Live",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Unified offline-first church live show control",
    "longDescription": "Luma Live combines Arrangement song control, Session View Busk tools, songs, setlists, plain-language commands, and a same-network remote in one local-first application.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
